# ── GCP Configuration (optional — only needed when USE_REAL_* = true) ─────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-east1
FIRESTORE_DATABASE=your-firestore-db-name

# ── Service Toggles ──────────────────────────────────────────────────────────
# Default: false — runs fully locally with in-memory simulators (no GCP needed).
# Set to 'true' only if you have active GCP credentials (gcloud auth login).
USE_REAL_VERTEX=false
USE_REAL_FIRESTORE=false
USE_REAL_SPANNER=false

# ── AI Model Configuration ───────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# ── Local Development ────────────────────────────────────────────────────────
# Optional: paste a Gemini REST API key to get live AI responses.
# Without this, the app uses deterministic simulator templates (fully functional).
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Keep in-memory/local storage (no Firestore needed)
USE_LOCAL_STORAGE=true

# Port for the Flask development server
PORT=5000

# ── Fine-Tuned Classifier (advanced — optional) ──────────────────────────────
# Only needed after completing a Vertex AI tuning job.
TUNED_CLASSIFIER_MODEL=
